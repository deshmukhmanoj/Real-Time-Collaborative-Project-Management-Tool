# Leave these as /api and unset in development — vite.config.ts proxies
# /api and /socket.io to http://localhost:5000 automatically.
# Set both explicitly for production builds pointed at a deployed backend.
VITE_API_BASE_URL=https://real-time-collaborative-backend-msg7.onrender.com/api
VITE_SOCKET_URL=https://real-time-collaborative-backend-msg7.onrender.com
